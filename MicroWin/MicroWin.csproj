<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <StartupObject>MicroWin.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Disable auto-generated assembly attributes to avoid duplication with Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Regional\GeoId.xml" />
    <None Remove="Resources\Regional\ImageLanguage.xml" />
    <None Remove="Resources\Regional\KeyboardIdentifier.xml" />
    <None Remove="Resources\Regional\TimeOffset.xml" />
    <None Remove="Resources\Regional\UserLocale.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrate Microsoft.Dism to PackageReference; keep pinned version from assessment -->
    <PackageReference Include="Microsoft.Dism" Version="6.1.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep native/tools files as content so they remain in the output and/or source tree -->
    <EmbeddedResource Include="Resources\Regional\GeoId.xml" />
    <EmbeddedResource Include="Resources\Regional\ImageLanguage.xml" />
    <EmbeddedResource Include="Resources\Regional\KeyboardIdentifier.xml" />
    <EmbeddedResource Include="Resources\Regional\TimeOffset.xml" />
    <EmbeddedResource Include="Resources\Regional\UserLocale.xml" />
    <EmbeddedResource Include="tools\oscdimg.exe" />
    <EmbeddedResource Include="tools\FirstStartup.ps1" />
    <None Include="tools\RemoveTempDir.bat" />
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Resource files are included implicitly by the SDK; explicit EmbeddedResource entries removed to avoid duplicates -->

  <!-- Keep packages.config in the repository, but it's no longer used by SDK-style projects. -->

</Project>
